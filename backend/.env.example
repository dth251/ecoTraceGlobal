# Sao chép thành backend/.env rồi điền thông tin PostgreSQL cục bộ (file .env không được commit)
DB_URL=jdbc:postgresql://localhost:5432/ecoTraceGlobal
DB_USER=ecotrace
DB_PASSWORD=
# Thư mục lưu file chứng từ và khóa ký hộ chiếu khi chạy local (không cần MinIO/S3)
STORAGE_LOCAL_DIR=./data/uploads
PASSPORT_SIGNING_KEY_PATH=./data/passport-signing-key.txt
# Địa chỉ AI service (FastAPI)
AI_SERVICE_URL=http://localhost:8001
